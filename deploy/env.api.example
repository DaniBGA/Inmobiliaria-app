# Copiar a app/api/.env en el VPS (NO commitear el real).
#
# DATABASE_URL: mismo usuario/base que deploy/docker-compose.prod.yml
# (POSTGRES_USER=sgm, POSTGRES_DB=sgm_ar), con la MISMA contraseña que le
# pusiste ahí en deploy/.env, contra 127.0.0.1:5433 (el puerto publicado
# por ese compose).
DATABASE_URL="postgresql://sgm:REEMPLAZAR_MISMA_PASSWORD_QUE_DEPLOY_ENV@127.0.0.1:5433/sgm_ar?schema=public"

# Generar con: openssl rand -base64 48 — nunca usar el valor de dev.
JWT_SECRET="REEMPLAZAR_CON_UN_SECRETO_LARGO_Y_ALEATORIO"
JWT_EXPIRES_IN="8h"

PORT=3000
NODE_ENV=production

# Solo se usan una vez, al sembrar la base la primera vez (prisma:seed) —
# después de eso no hacen nada (el seed es idempotente, no pisa el admin
# si ya existe). Poné una contraseña real acá ANTES de sembrar — si no se
# define, el seed usa el default "changeme123" del repo, que no hay que
# dejar en producción.
SEED_ADMIN_EMAIL="FacundoParis@gmail.com"
SEED_ADMIN_PASSWORD="REEMPLAZAR_CON_UNA_CONTRASENA_REAL"

# Envío de emails del formulario de contacto de la landing. Si se dejan
# vacías, el envío se salta en silencio (no rompe el formulario, solo no
# llegan notificaciones). Ver DEPLOY.md / guía de Gmail App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="REEMPLAZAR_CON_EL_GMAIL_QUE_ENVIA"
SMTP_PASS="REEMPLAZAR_CON_EL_APP_PASSWORD_DE_16_LETRAS"
# (A qué casilla llegan las consultas: eso NO se configura acá — se carga
# desde el admin en Configuración → Datos públicos, campo Email.)
