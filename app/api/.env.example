DATABASE_URL="postgresql://sgm:sgm_dev_password@localhost:5433/sgm_ar?schema=public"
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="8h"
PORT=3000

# Sin definir en dev: se refleja cualquier origen (localhost en varios
# puertos). En producción se define con el dominio real — ver
# deploy/env.api.example.
# ALLOWED_ORIGINS="https://tudominio.com"

# Envío de emails (hoy solo lo usa el formulario de contacto de la landing).
# Si se dejan vacías, el envío se salta en silencio — no rompe nada, solo
# no llegan las notificaciones. Ver guía de Gmail App Password en el chat.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
# (A qué casilla llegan las consultas del formulario de contacto: eso NO
# se configura acá — se carga desde el admin en Configuración → Datos
# públicos, campo Email.)
# Poner "true" SOLO si en desarrollo local el envío falla con "unable to
# verify the first certificate" (típico cuando un antivirus como Kaspersky/
# ESET inspecciona el tráfico HTTPS). NUNCA activarlo en producción.
SMTP_TLS_INSECURE="false"
